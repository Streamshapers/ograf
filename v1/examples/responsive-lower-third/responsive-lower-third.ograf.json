{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "responsive-lower-third",
  "name": "Responsive Lower Third",
  "main": "graphic.mjs",
  "thumbnails": [
    {
      "file": "thumbnail.webp",
      "resolution": {
        "width": 1280,
        "height": 720
      }
    }
  ],
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "name":    { "type": "string", "default": "Anders Berg" },
      "title":   { "type": "string", "default": "Senior Correspondent" },
      "channel": { "type": "string", "default": "OGraf News" }
    }
  }
}
