{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "ograf-demo-scoreboard",
  "name": "Live Scoreboard",
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 5,
  "schema": {
    "type": "object",
    "properties": {
      "homeTeam":  { "type": "string",  "default": "FC Zürich" },
      "awayTeam":  { "type": "string",  "default": "Ajax Amsterdam" },
      "homeShort": { "type": "string",  "default": "FCZ", "maxLength": 4 },
      "awayShort": { "type": "string",  "default": "AJX", "maxLength": 4 },
      "homeScore": { "type": "integer", "default": 0, "minimum": 0 },
      "awayScore": { "type": "integer", "default": 0, "minimum": 0 },
      "homeColor": { "type": "string",  "default": "#005ca9" },
      "awayColor": { "type": "string",  "default": "#d4192c" },
      "minute":    { "type": "integer", "default": 0, "minimum": 0, "maximum": 90 },
      "seconds":   { "type": "integer", "default": 0, "minimum": 0, "maximum": 59 },
      "step": {
        "type": "string",
        "default": "pre-match",
        "enum": ["pre-match", "live", "half-time", "second-half", "full-time"]
      }
    }
  },
  "customActions": [
    {
      "id": "next-step",
      "name": "Next Step",
      "description": "Advance through the match lifecycle: pre-match → live → half-time → second-half → full-time"
    },
    {
      "id": "goal-home",
      "name": "Goal (Home)",
      "description": "Increment the home team score by 1"
    },
    {
      "id": "goal-away",
      "name": "Goal (Away)",
      "description": "Increment the away team score by 1"
    }
  ]
}
